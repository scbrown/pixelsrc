// skull_anim.pxl - idle, laugh and glowing-eye loops for the skull in skull.pxl
//
// The same art as skull.pxl on a 44x44 canvas, so the head has room to float
// and the jaw has room to drop. Compositions can't offset a layer and derived
// `shift` sprites don't survive into compositions or GIF frames (GAPS.md #4),
// so the two head heights ("rest" and "up", 1px higher) are written out as
// separate sprites. Every frame is a composition of cranium + jaw + an
// optional overlay (blink or ember glow) at the same height.
//
// A frame-list animation has a single frame duration (GAPS.md #6), so holds
// are made by repeating a frame.

// Same bone palette as skull.pxl (palette @include breaks in GIF frames, GAPS.md #7)
{
  type: "palette",
  name: "bone",
  colors: {
    _: "transparent",
    lit: "transparent",   // mask only: the lit side of the cranium
    gap: "transparent",   // see-through hole at the corner of the mouth
    outline: "#6f6a64",
    crease: "#7c766f",
    hi: "#fefded",        // cream highlight
    edge: "#fefded",
    tooth: "#fefded",
    root: "#fefded",
    bone: "#e6dccd",      // beige base
    fleck: "#e6dccd",
    mid: "#c5baa9",       // tan shadow
    shade: "#c5baa9",
    gum: "#c5baa9",
    umber: "#a4998a",     // deepest bone shadow
    seam: "#a4998a",
    socket: "#554d48",    // dark warm grey cavities
    rim: "#7f7a74",       // lighter inner wall of the orbits
  },
}

// Overlay colours: lids reuse the socket dark; the ember ramp is kept low and warm
{
  type: "palette",
  name: "ember",
  colors: {
    _: "transparent",
    lid: "#554d48",
    ember: "#86645a",
    coal: "#a8603c",
    flame: "#e0904a",
    spark: "#ffcf8a",
  },
}

