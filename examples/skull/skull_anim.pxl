// ---------------------------------------------------------------------------
// Animations
// ---------------------------------------------------------------------------
// Idle: a slow 1px float, with one blink (the sockets go dark) every other bob.
{
  type: "animation",
  name: "skull_idle",
  frames: [
    "f_rest_closed", "f_rest_closed", "f_rest_closed",
    "f_rest_closed", "f_rest_closed", "f_rest_closed",
    "f_up_closed", "f_up_closed", "f_up_closed",
    "f_up_closed", "f_up_closed", "f_up_closed",
    "f_rest_closed", "f_rest_closed", "f_rest_closed",
    "f_rest_closed", "f_rest_closed", "f_rest_closed",
    "f_up_closed", "f_up_closed", "f_up_closed_blink_half",
    "f_up_closed_blink_full", "f_up_closed_blink_half", "f_up_closed",
  ],
  duration: 120,
  loop: true,
}

// Laugh: fast jaw chatter (jaw_wide drops the chin 3px), the head tipping up a pixel on every open.
{
  type: "animation",
  name: "skull_laugh",
  frames: [
    "f_rest_closed", "f_up_wide", "f_up_ajar",
    "f_up_wide", "f_rest_closed", "f_up_open",
    "f_rest_ajar", "f_up_wide", "f_rest_closed",
    "f_up_open", "f_rest_ajar", "f_rest_closed",
  ],
  duration: 70,
  loop: true,
}

// Eyes: the idle float with ember light flickering in the sockets (glow_1..3 overlays).
{
  type: "animation",
  name: "skull_eyes",
  frames: [
    "f_rest_closed_glow_1", "f_rest_closed_glow_2", "f_rest_closed_glow_2",
    "f_rest_closed_glow_3", "f_rest_closed_glow_2", "f_rest_closed_glow_1",
    "f_up_closed_glow_1", "f_up_closed_glow_2", "f_up_closed_glow_3",
    "f_up_closed_glow_3", "f_up_closed_glow_2", "f_up_closed_glow_2",
    "f_rest_closed_glow_1", "f_rest_closed_glow_1", "f_rest_closed_glow_2",
    "f_rest_closed_glow_3", "f_rest_closed_glow_2", "f_rest_closed_glow_1",
    "f_up_closed_glow_2", "f_up_closed_glow_2", "f_up_closed_glow_1",
    "f_up_closed_glow_1", "f_up_closed_glow_2", "f_up_closed_glow_2",
  ],
  duration: 120,
  loop: true,
}
