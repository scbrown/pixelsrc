// skull-256.pxl - Stiwi's skull avatar, 256x256, painterly.
//
// The same 3/4 view as skull-128.pxl, after reference-skull.jpg.
// The big planes started from the 128 portrait's shapes at double size; the
// rest is painted for this size: a nine-step bone ramp, checker-dithered
// transitions between neighbouring tones, reflected light under the cranium,
// ambient occlusion in the orbits and per-tooth modelling.
//
// The dithering uses one hidden `grain` mask: a 50% checkerboard drawn as
// diagonal one-pixel lines. A transition region is a hand-drawn band with
// `except: ["grain"]`, so only every other pixel of the band takes its tone.
// (The sprite-level `dither` transform fails on a regions sprite; see GAPS.md.)
//
// Region maps are unordered, so every region carries its own unique z.

{
  type: "palette",
  name: "skull-256",
  colors: {
    _: "transparent",
    grain: "transparent",   // mask only: the checkerboard used by the dither bands

    // the bone ramp, darkest to brightest
    outline: "#4b4541",
    seam: "#776f68",
    deep: "#8a8074",
    umber: "#a0968a",
    mid: "#b8ad9c",
    tan: "#cdc2b0",
    bone: "#e2d8c8",
    light: "#eee6d4",
    cream: "#f7f1e2",
    hi: "#fffdf0",
    reflect: "#c2b29b",     // warm bounce light under the back of the skull

    // checker-dithered transitions; each one is the colour of the tone it carries
    "dither-light": "#eee6d4",
    "dither-cream": "#f7f1e2",
    "dither-hi": "#fffdf0",
    "dither-tan": "#cdc2b0",
    "dither-mid": "#b8ad9c",
    "dither-umber": "#a0968a",
    "dither-deep": "#8a8074",
    "dither-socket": "#7d746b",

    // orbits
    socket: "#2b2624",
    "socket-mid": "#554d48",
    "socket-floor": "#746b64",
    "socket-rim": "#9a9289",

    // mandible and cheek
    "light-jaw": "#efe8d7",
    "hi-jaw": "#fffdf0",

    // nose
    "nose-bridge": "#f2ebda",
    "nose-shade": "#bdb2a1",
    nose: "#2b2624",
    "nose-concha": "#5b524c",
    "nose-septum": "#827970",
    "nose-floor": "#433c38",

    // teeth
    "teeth-upper": "#f4eedd",
    "teeth-lower": "#e9e1cf",
    "teeth-gum": "#9d9283",
    "teeth-bite": "#5b524c",
    "teeth-gaps": "#a99e8d",
    "teeth-shade": "#d4cab8",
    "teeth-glint": "#fffdf0",
    gap: "#241f1d",

    // small anatomy
    foramen: "#857b70",
    crack: "#8f8478",
  },
  roles: {
    grain: "fill",
    outline: "boundary", seam: "boundary", deep: "shadow", umber: "shadow", mid: "shadow", tan: "shadow",
    bone: "fill", light: "highlight", cream: "highlight", hi: "highlight", reflect: "highlight",
    "dither-light": "highlight", "dither-cream": "highlight", "dither-hi": "highlight", "dither-tan": "shadow",
    "dither-mid": "shadow", "dither-umber": "shadow", "dither-deep": "shadow", "dither-socket": "shadow",
    socket: "anchor", "socket-mid": "shadow", "socket-floor": "fill", "socket-rim": "highlight",
    "light-jaw": "highlight", "hi-jaw": "highlight",
    "nose-bridge": "highlight", "nose-shade": "shadow", nose: "anchor", "nose-concha": "shadow",
    "nose-septum": "fill", "nose-floor": "shadow",
    "teeth-upper": "fill", "teeth-lower": "fill", "teeth-gum": "boundary", "teeth-bite": "anchor",
    "teeth-gaps": "boundary", "teeth-shade": "shadow", "teeth-glint": "highlight", gap: "anchor",
    foramen: "anchor", crack: "boundary",
  },
  relationships: {
    light: {type: "derives-from", target: "bone"},
    cream: {type: "derives-from", target: "bone"},
    hi: {type: "derives-from", target: "bone"},
    tan: {type: "derives-from", target: "bone"},
    mid: {type: "derives-from", target: "bone"},
    umber: {type: "derives-from", target: "bone"},
    deep: {type: "derives-from", target: "bone"},
    reflect: {type: "derives-from", target: "umber"},
    "socket-floor": {type: "derives-from", target: "socket"},
  },
}

