{
  type: "sprite", name: "stiwi-hand-32", size: [32,32], palette: "stiwi-hand-32",
  regions: {
    background: {rect: [0,0,32,32], z: 0},
    "background-light": {union: [{rect: [0,0,9,10], round: 3},{rect: [25,0,7,16], round: 3},{rect: [0,18,5,8], round: 2}], z: 1},
