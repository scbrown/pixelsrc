    "eye-white": {union: [{rect: [11,13,3,1]},{rect: [19,13,3,1]}], z: 30},
    iris: {points: [[12,13],[20,13]], z: 31},
    pupil: {points: [[12,14],[20,14]], z: 32},
    // Full beard tapers below the jaw; it is not a dark rectangular mouth.
