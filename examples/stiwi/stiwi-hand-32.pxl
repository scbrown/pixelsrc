    // Exposed forehead, cheeks and small ear lobes.
    skin: {union: [{rect: [9,7,14,17], round: 4},{rect: [8,13,2,6], round: 1},{rect: [23,13,2,6], round: 1}], z: 20},
    "skin-light": {union: [{rect: [11,8,7,4], round: 1},{rect: [10,16,3,3], round: 1},{line: [[16,14],[16,17]]}], z: 21},
    "skin-shadow": {union: [{line: [[22,10],[22,17],[23,19]], thickness: 1},{line: [[9,17],[10,20]]},{points: [[8,15],[24,15],[18,17],[15,18]]}], z: 22},
    "skin-warm": {union: [{rect: [13,16,3,3]},{rect: [17,16,3,3]},{points: [[16,18],[17,17]]}], z: 23},
    // An extra right-hand forelock covers the bare upper temple.
    "hair-swoop": {line: [[20,7],[21,9],[23,11],[25,11]], thickness: 3, z: 24},
    // Hair sweeps over the forehead without flattening the open face.
    "hair-wave": {union: [{line: [[8,9],[9,6],[12,4],[15,4]]},{line: [[14,3],[16,2],[19,3],[20,6],[22,8],[25,8]]},{line: [[8,12],[7,13],[8,15]]},{line: [[7,17],[8,19]]},{line: [[25,13],[26,14],[25,16],[26,17],[24,19]]},{line: [[21,8],[22,9],[24,10]]}], z: 25},
